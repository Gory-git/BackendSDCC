# Copia in .env e riempi. Il .env vero non va in git (escluso dal .gitignore).

# Obbligatoria: nessun default, così non si finisce in produzione con una
# password indovinabile.
POSTGRES_PASSWORD=cambiami

# Dominio pubblico. In locale lasciare i default (Caddy su :80 in HTTP).
# In produzione: SITE_ADDRESS=receipthub.duckdns.org
#                PUBLIC_ORIGIN=https://receipthub.duckdns.org
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost

# Immagini. In locale sono quelle costruite a mano, in produzione i tag ECR.
BACKEND_IMAGE=receipthub-backend:local
FRONTEND_IMAGE=receipthub-frontend:local

# Bucket S3 dei PDF. Obbligatoria: il nome contiene l'ID dell'account AWS,
# quindi non ha un default nel repository. Sull'istanza la scrive lo script di
# bootstrap; qui va messa a mano per provare lo stack in locale.
AWS_S3_BUCKET=
AWS_S3_REGION=eu-north-1

# Chiave del chatbot. Se manca, il backend parte lo stesso e /chat risponde 503.
OPENAI_API_KEY=
