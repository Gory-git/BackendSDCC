{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TokenDiAutenticazioneECR",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushSuiDueRepositoryECR",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:eu-north-1:094028239135:repository/receipthub-backend",
        "arn:aws:ecr:eu-north-1:094028239135:repository/receipthub-frontend"
      ]
    },
    {
      "Sid": "AggiornamentoDellIstanza",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:eu-north-1:094028239135:instance/i-0354f9b9b2e87d955",
        "arn:aws:ssm:eu-north-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "LetturaEsitoDeiComandi",
      "Effect": "Allow",
      "Action": ["ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*"
    }
  ]
}
