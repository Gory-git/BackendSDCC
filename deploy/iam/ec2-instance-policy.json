{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccessoAlBucketDelleRicevute",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::backendsdcc-dev-files-001-<ACCOUNT_ID>-eu-north-1-an/*"
    },
    {
      "Sid": "ElencoDelBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::backendsdcc-dev-files-001-<ACCOUNT_ID>-eu-north-1-an"
    }
  ]
}
